{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "matchCategories": [
        "docker"
      ],
      "pinDigests": true
    },
    {
      "matchManagers": [
        "dockerfile"
      ],
      "matchPackageNames": [
        "debian"
      ],
      "commitMessageTopic": "debian base image",
      "schedule": [
        "at any time"
      ]
    },
    {
      "description": "The example compose file tracks :latest on purpose; see the Tags table in README for pinning.",
      "matchManagers": [
        "docker-compose"
      ],
      "matchPackageNames": [
        "dancwilliams/protonmail-bridge"
      ],
      "enabled": false
    }
  ]
}
